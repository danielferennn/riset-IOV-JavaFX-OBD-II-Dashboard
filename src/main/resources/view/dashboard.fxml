<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.obd2dashboard.controller.DashboardController"
            stylesheets="@../css/dashboard.css"
            styleClass="app-root">
    <top>
        <VBox spacing="12" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="appTitleLabel" text="OBD2 TELEMETRY" styleClass="app-title"/>
                    <Label fx:id="appSubtitleLabel" text="Live vehicle diagnostics dashboard"
                           styleClass="app-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="6" styleClass="language-selector">
                    <Label fx:id="languageLabel" text="Bahasa" styleClass="field-label"/>
                    <ComboBox fx:id="languageComboBox" prefWidth="150"/>
                </HBox>
                <HBox fx:id="statusPill" alignment="CENTER" spacing="8" styleClass="status-pill">
                    <Region styleClass="status-dot"/>
                    <Label fx:id="statusLabel" text="Terputus" styleClass="status-text"/>
                </HBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="9" styleClass="toolbar">
                <Label fx:id="portFieldLabel" text="Port" styleClass="field-label"/>
                <ComboBox fx:id="portComboBox" prefWidth="125"/>
                <Button fx:id="refreshPortsButton" text="Segarkan Port" onAction="#refreshPorts"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="baudFieldLabel" text="Baud" styleClass="field-label"/>
                <ComboBox fx:id="baudRateComboBox" prefWidth="115"/>
                <Button fx:id="connectButton" text="Hubungkan" onAction="#connect" styleClass="button-connect"/>
                <Button fx:id="disconnectButton" text="Putuskan" onAction="#disconnect" disable="true"/>
                <ToggleButton fx:id="simulationToggle" text="Simulasi" onAction="#toggleSimulation"
                              styleClass="simulation-toggle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lastUpdatedLabel" text="Belum ada data" styleClass="last-updated"/>
            </HBox>
            <padding>
                <Insets top="16" right="20" bottom="14" left="20"/>
            </padding>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" pannable="true" styleClass="dashboard-scroll">
            <VBox spacing="16">
                <FlowPane hgap="12" vgap="12" alignment="TOP_LEFT" prefWrapLength="1080">
                    <VBox spacing="8" styleClass="telemetry-card,primary-card">
                        <Label fx:id="rpmCardTitle" text="ENGINE RPM" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="rpmValueLabel" text="--" styleClass="card-value"/>
                            <Label text="rpm" styleClass="card-unit"/>
                        </HBox>
                        <ProgressBar fx:id="rpmProgressBar" progress="0" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="8" styleClass="telemetry-card,primary-card">
                        <Label fx:id="speedCardTitle" text="VEHICLE SPEED" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="speedValueLabel" text="--" styleClass="card-value"/>
                            <Label text="km/h" styleClass="card-unit"/>
                        </HBox>
                        <ProgressBar fx:id="speedProgressBar" progress="0" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="coolantCardTitle" text="COOLANT" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="coolantValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="°C" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="engineLoadCardTitle" text="ENGINE LOAD" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="engineLoadValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="\%" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="throttleCardTitle" text="THROTTLE" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="throttleValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="\%" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="intakeAirCardTitle" text="INTAKE AIR" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="intakeAirValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="°C" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="fuelCardTitle" text="FUEL LEVEL" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="fuelValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="\%" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="manifoldCardTitle" text="MANIFOLD PRESSURE" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="manifoldValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="kPa" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="7" styleClass="telemetry-card">
                        <Label fx:id="voltageCardTitle" text="VOLTAGE" styleClass="card-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="7">
                            <Label fx:id="voltageValueLabel" text="--" styleClass="card-value-small"/>
                            <Label text="V" styleClass="card-unit"/>
                        </HBox>
                    </VBox>
                </FlowPane>

                <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS">
                    <VBox spacing="12" styleClass="panel">
                        <Label fx:id="historySectionTitle" text="LIVE HISTORY" styleClass="section-title"/>
                        <GridPane hgap="12" vgap="12" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="ALWAYS"/>
                            </rowConstraints>
                            <LineChart fx:id="rpmChart" animated="false" legendVisible="false"
                                       title="Engine RPM" GridPane.columnIndex="0">
                                <xAxis>
                                    <NumberAxis fx:id="rpmXAxis" label="Seconds" forceZeroInRange="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="rpmYAxis" label="RPM" lowerBound="0" upperBound="6000"
                                                tickUnit="1000" autoRanging="false"/>
                                </yAxis>
                            </LineChart>
                            <LineChart fx:id="speedChart" animated="false" legendVisible="false"
                                       title="Vehicle Speed" GridPane.columnIndex="1">
                                <xAxis>
                                    <NumberAxis fx:id="speedXAxis" label="Seconds" forceZeroInRange="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="speedYAxis" label="km/h" lowerBound="0" upperBound="200"
                                                tickUnit="40" autoRanging="false"/>
                                </yAxis>
                            </LineChart>
                        </GridPane>
                    </VBox>
                    <VBox spacing="10" styleClass="panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="logSectionTitle" text="COMMUNICATION LOG" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="clearLogButton" text="Clear Log" onAction="#clearLog"
                                    styleClass="button-small"/>
                        </HBox>
                        <TextArea fx:id="communicationLog" prefRowCount="16" VBox.vgrow="ALWAYS"
                                  styleClass="communication-log"/>
                    </VBox>
                </SplitPane>

                <VBox spacing="10" styleClass="panel">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label fx:id="dtcSectionTitle" text="DIAGNOSTIC TROUBLE CODES"
                                   styleClass="section-title"/>
                            <Label fx:id="dtcSectionSubtitle" text="Mode 03 stored trouble codes"
                                   styleClass="section-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="readDtcButton" text="Read DTC" onAction="#readDtc" disable="true"
                                styleClass="button-accent"/>
                    </HBox>
                    <ListView fx:id="dtcListView" prefHeight="105"/>
                </VBox>
                <padding>
                    <Insets top="16" right="20" bottom="20" left="20"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
